{
  "name": "@tepian-k3/server",
  "version": "1.5.0",
  "private": true,
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsdown && node -e \"const{cpSync}=require('fs');cpSync('../../packages/services/src/pdf/assets','./assets',{recursive:true,force:true})\"",
    "check-types": "tsc -b",
    "compile": "bun with-env build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "pnpm with-env:local tsx watch src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "pnpm with-env:prod node dist/index.mjs",
    "with-env:local": "dotenv -e ../../.env.local -e ../../.env --",
    "with-env:prod": "dotenv -e ../../.env.production -e ../../.env --"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "@hono/trpc-server": "^0.4.0",
    "@node-rs/argon2": "catalog:",
    "@t3-oss/env-core": "^0.13.10",
    "@tepian-k3/api": "workspace:*",
    "@tepian-k3/auth": "workspace:*",
    "@tepian-k3/db": "workspace:*",
    "@tepian-k3/queries": "workspace:*",
    "@tepian-k3/services": "workspace:*",
    "@trpc/server": "catalog:",
    "date-fns": "catalog:",
    "dotenv": "catalog:",
    "hono": "catalog:",
    "mime-types": "catalog:",
    "sharp": "^0.34.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.2.0",
    "@tepian-k3/config": "workspace:*",
    "@tepian-k3/types": "workspace:*",
    "@types/mime-types": "catalog:",
    "@types/node": "^22.13.11",
    "dotenv-cli": "^11.0.0",
    "tsdown": "^0.16.5",
    "tsx": "^4.19.2",
    "typescript": "catalog:"
  }
}
