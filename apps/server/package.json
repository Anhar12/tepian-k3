{
  "name": "@tepian-k3/server",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "check-types": "tsc -b",
    "compile": "bun with-env build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "pnpm with-env tsx watch src/index.ts",
    "start": "pnpm with-env tsx src/index.ts",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "@hono/trpc-server": "^0.4.0",
    "@t3-oss/env-core": "^0.13.10",
    "@tepian-k3/api": "workspace:*",
    "@tepian-k3/db": "workspace:*",
    "@tepian-k3/services": "workspace:*",
    "@trpc/server": "catalog:",
    "dotenv": "catalog:",
    "hono": "catalog:",
    "mime-types": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tepian-k3/config": "workspace:*",
    "@tepian-k3/types": "workspace:*",
    "@types/mime-types": "catalog:",
    "@types/node": "^22.13.11",
    "dotenv-cli": "^11.0.0",
    "tsdown": "^0.16.5",
    "tsx": "^4.19.2",
    "typescript": "catalog:"
  }
}
