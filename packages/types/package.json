{
  "name": "@tepian-k3/types",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    },
    "./platform/*": {
      "default": "./src/platform/*.ts"
    },
    "./pengujian/*": {
      "default": "./src/pengujian/*.ts"
    },
    "./pelatihan/*": {
      "default": "./src/pelatihan/*.ts"
    },
    "./uji-kompetensi/*": {
      "default": "./src/uji-kompetensi/*.ts"
    },
    "./konsultasi/*": {
      "default": "./src/konsultasi/*.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "check-types": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@tepian-k3/config": "workspace:*",
    "type-fest": "^5.3.1",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@tanstack/react-table": "catalog:",
    "@tepian-k3/constants": "workspace:*",
    "@tepian-k3/db": "workspace:*",
    "@tepian-k3/shared": "workspace:*",
    "jose": "^6.1.3"
  }
}
