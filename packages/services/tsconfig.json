{
  "extends": "@tepian-k3/config/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "composite": true,
    "noUnusedLocals": false,
    "paths": {
      "env": ["./env.ts"]
    }
  },
  "exclude": [
    "node_modules",
    "./dist/**/*",
    "src/**/docs/**/*.example.ts",
    "src/**/docs/**/*.example.md"
  ]
}
