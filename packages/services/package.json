{
  "name": "@tepian-k3/services",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "check-types": "tsc -b",
    "email:dev": "email dev --dir ./src/email/dev --port 3001",
    "email:verify": "pnpm with-env tsx src/scripts/verify-email.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "with-env": "dotenv -e ../../.env --"
  },
  "exports": {
    "./email": {
      "default": "./src/email/index.ts"
    },
    "./logger": {
      "default": "./src/logger/index.ts"
    },
    "./storage": {
      "default": "./src/storage/index.ts"
    },
    "./notifications": {
      "default": "./src/notifications/index.ts"
    },
    "./pdf": {
      "default": "./src/pdf/index.ts"
    },
    "./document-signing": {
      "default": "./src/document-signing/index.ts"
    },
    "./image": {
      "default": "./src/image/index.ts"
    },
    "./rate-limiter": {
      "default": "./src/rate-limiter/index.ts"
    },
    "./cache": {
      "default": "./src/cache/index.ts"
    },
    "./queue": {
      "default": "./src/queue/index.ts"
    },
    "./token-blacklist": {
      "default": "./src/token-blacklist/index.ts"
    },
    "./idempotency": {
      "default": "./src/idempotency/index.ts"
    }
  },
  "dependencies": {
    "@react-email/components": "^1.0.1",
    "@react-email/render": "^2.0.0",
    "@react-pdf/renderer": "^4.3.2",
    "@tepian-k3/constants": "workspace:*",
    "@trpc/server": "catalog:",
    "bullmq": "^5.67.2",
    "clsx": "^2.1.1",
    "date-fns": "catalog:",
    "file-saver": "^2.0.5",
    "file-type": "^21.3.0",
    "ioredis": "^5.9.1",
    "jose": "catalog:",
    "logform": "^2.7.0",
    "minio": "^8.0.7",
    "nodemailer": "^7.0.11",
    "pdf-lib": "catalog:",
    "qrcode": "catalog:",
    "react": "catalog:react19",
    "react-pdf-tailwind": "^3.0.0",
    "resend": "^6.6.0",
    "sharp": "^0.34.5",
    "uuid": "catalog:",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@react-email/preview-server": "5.0.8",
    "@t3-oss/env-core": "^0.13.10",
    "@tepian-k3/config": "workspace:*",
    "@tepian-k3/schema": "workspace:*",
    "@tepian-k3/types": "workspace:*",
    "@tepian-k3/utils": "workspace:*",
    "@types/file-saver": "^2.0.7",
    "@types/nodemailer": "^7.0.11",
    "@types/qrcode": "catalog:",
    "@types/react": "catalog:react19",
    "dotenv-cli": "^11.0.0",
    "effect": "catalog:",
    "react-email": "^5.0.8",
    "tsx": "^4.19.0"
  }
}
