{
  "name": "@tepian-k3/db",
  "version": "1.15.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./client": {
      "default": "./src/client.ts"
    },
    "./schema": {
      "default": "./src/schema.ts"
    },
    "./utils": {
      "default": "./src/utils.ts"
    },
    "./relations": {
      "default": "./src/relations.ts"
    }
  },
  "scripts": {
    "check-types": "tsc -b",
    "db:push": "pnpm with-env drizzle-kit push",
    "db:generate": "pnpm with-env drizzle-kit generate",
    "db:studio": "pnpm with-env drizzle-kit studio",
    "db:migrate": "pnpm with-env drizzle-kit migrate",
    "db:seed": "pnpm with-env tsx ./src/seed/index.ts",
    "db:reset": "pnpm with-env tsx ./src/reset/index.ts",
    "db:purge": "pnpm with-env tsx ./src/purge/index.ts",
    "db:snapshot": "bash ./scripts/db-snapshot.sh",
    "db:restore": "bash ./scripts/db-restore.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "with-env": "dotenv -e ../../.env --"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.2.0",
    "@tepian-k3/config": "workspace:*",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.8",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@node-rs/argon2": "catalog:",
    "@t3-oss/env-core": "^0.13.10",
    "@tepian-k3/constants": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.1",
    "drizzle-seed": "^0.3.1",
    "ioredis": "^5.9.1",
    "postgres": "^3.4.7",
    "tsx": "^4.21.0",
    "uuid": "catalog:",
    "zod": "catalog:"
  }
}
