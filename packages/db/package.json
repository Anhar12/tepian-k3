    "db:migrate": "pnpm with-env drizzle-kit migrate",
    "with-env": "dotenv -e ../../.env --"
  },
  "devDependencies": {
    "@tepian-k3/config": "workspace:*",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.8",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.10",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.1",
