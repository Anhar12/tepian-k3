# ============================================
# DOCKER COMPOSE ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and update the values before running docker compose.
#
# Production: docker compose up --build
# Development: docker compose -f docker-compose.dev.yml up

# ============================================
# POSTGRES
# ============================================
POSTGRES_USER=tepian
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=tepian_k3
# Only used in dev compose (host-mapped port)
POSTGRES_PORT=5433

# ============================================
# REDIS
# ============================================
REDIS_PASSWORD=change_me_in_production
# Only used in dev compose (host-mapped port)
REDIS_PORT=6380

# ============================================
# SERVER
# ============================================
CORS_ORIGIN=http://localhost:3001

# ============================================
# AUTHENTICATION SECRETS (REQUIRED)
# ============================================
# Generate with: pnpm regenerate:jwt
JWT_SECRET=your-main-jwt-secret
JWT_RESET_PASSWORD_SECRET=your-reset-password-secret

# ============================================
# DOCUMENT SIGNING SECRETS (REQUIRED)
# ============================================
# Generate with: pnpm regenerate:jwt
JWT_DOCUMENT_SECRET=your-main-document-secret
# Optional type-specific secrets (falls back to JWT_DOCUMENT_SECRET)
JWT_LEGAL_DOCUMENT_SECRET=your-legal-document-secret
JWT_TESTING_DOCUMENT_SECRET=your-testing-document-secret
JWT_COMPANY_DOCUMENT_SECRET=your-company-document-secret

# ============================================
# DOCUMENT CONFIGURATION
# ============================================
DOCUMENT_QR_EXPIRATION=10y
DOCUMENT_VERIFICATION_BASE_URL=http://localhost:3001/verify

# ============================================
# STORAGE
# ============================================
STORAGE_PROVIDER=filesystem

# ============================================
# EMAIL
# ============================================
EMAIL_PROVIDER=ethereal
EMAIL_FROM=noreply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=

# ============================================
# WEB BUILD (baked into JS bundle)
# ============================================
# Public URL where the web app is accessible (used by browser for API calls)
VITE_SERVER_URL=http://localhost:3001

# ============================================
# APP URLS
# ============================================
APP_URL=http://localhost:3001
DASHBOARD_URL=http://localhost:3001/dashboard

# ============================================
# EXPOSED PORTS
# ============================================
# The public-facing port for the web (nginx) container
WEB_PORT=3001
