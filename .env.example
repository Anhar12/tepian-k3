# ============================================
# GLOBAL ENVIRONMENT VARIABLES
# ============================================
NODE_ENV=development # Options: development, production, test


# ============================================
# SERVER ENVIRONMENT VARIABLES
# ============================================
SERVER_HOSTNAME=localhost
SERVER_PORT=3000
CORS_ORIGIN=http://localhost:3001


# ============================================
# REDIS CONFIGURATION
# ============================================
MEMURAI_HOST=localhost
MEMURAI_PORT=6379
MEMURAI_PASSWORD="your_redis_password"
RATE_LIMITER_ENABLED=true



# ============================================
# STORAGE SERVICE ENVIRONMENT VARIABLES
# ============================================
STORAGE_TYPE=filesystem # Options: filesystem, s3, minio


# Filesystem Storage Configuration (for STORAGE_TYPE=filesystem)
UPLOADS_DIR=uploads # Change this to your desired uploads directory
BASE_URL=http://localhost:3001 # Change this to your desired base URL (do not include /uploads). For all-in-one deployment, use the same proxied frontend URL as VITE_SERVER_URL.


# AWS S3 Configuration (for STORAGE_TYPE=s3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-key
AWS_SECRET_ACCESS_KEY=your-secret
S3_BUCKET=your-bucket-name


# MinIO Configuration (for STORAGE_TYPE=minio)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=uploads

# ============================================
# AUTHENTICATION SECRETS
# ============================================

# Main JWT secret for access tokens
# Generate with: regenerate:jwt
JWT_SECRET=your-main-jwt-secret

# Refresh token secret (used for long-lived session tokens)
# Generate with: regenerate:jwt
JWT_REFRESH_SECRET=your-refresh-token-secret

# Access token expiration (default: 15m)
# Valid formats: "15m", "1h", "2h", etc.
JWT_ACCESS_TOKEN_EXPIRY=15m

# Refresh token expiration (default: 30d)
# Valid formats: "7d", "30d", "60d", etc.
JWT_REFRESH_TOKEN_EXPIRY=30d

# Password reset token secret
# Generate with: regenerate:jwt
JWT_RESET_PASSWORD_SECRET=your-reset-password-secret


# ============================================
# DOCUMENT SIGNING SECRETS
# ============================================


# Main document signing secret (REQUIRED)
# This is used to sign ALL documents with JWT
# Generate with: regenerate:jwt
JWT_DOCUMENT_SECRET=your-main-document-secret


# Optional: Type-specific document secrets for additional security isolation
# If not provided, JWT_DOCUMENT_SECRET will be used as fallback


# For legal/contractual documents (orders, invoices, assignment letters)
# Generate with: regenerate:jwt
JWT_LEGAL_DOCUMENT_SECRET=your-legal-document-secret


# For testing/lab documents (reports, certificates)
# Generate with: regenerate:jwt
JWT_TESTING_DOCUMENT_SECRET=your-testing-document-secret


# For company verification documents (licenses, registrations)
# Generate with: regenerate:jwt
JWT_COMPANY_DOCUMENT_SECRET=your-company-document-secret


# ============================================
# DOCUMENT CONFIGURATION
# ============================================


# QR Code expiration (defaults to 10 years if not set)
# Valid formats: "7d", "30d", "1y", "10y", etc.
DOCUMENT_QR_EXPIRATION=10y


# Base URL for document verification
# Used to generate QR code verification URLs
DOCUMENT_VERIFICATION_BASE_URL=https://your-domain.com/verify/


# ============================================
# DATABASE PACKAGE ENVIRONMENT VARIABLES
# ============================================
POSTGRES_URL=postgresql://user:password@localhost:5432/dbname


# ============================================
# WEB APPLICATION ENVIRONMENT VARIABLES
# ============================================
# Frontend-facing URL - should match where your web app is served
# - Development: Vite dev server (port 3001) proxies /trpc to backend
# - Docker: nginx (port 3001) proxies /trpc to server container
# - Production: Use your public domain (e.g., https://yourdomain.com)
# This value is BAKED INTO THE JS BUNDLE at build time
VITE_SERVER_URL=http://localhost:3001


# ============================================
# EMAIL CONFIGURATION
# ============================================
EMAIL_FROM="noreply@yourdomain.com"
EMAIL_PROVIDER=smtp # Options: smtp, gmail, sendgrid, mailgun, ses, resend


# SMTP Configuration (for EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password


# Gmail Configuration (for EMAIL_PROVIDER=gmail)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password


# SendGrid SMTP (for EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=your-sendgrid-api-key


# Mailgun SMTP (for EMAIL_PROVIDER=mailgun)
MAILGUN_SMTP_HOST=smtp.mailgun.org
MAILGUN_SMTP_USER=postmaster@yourdomain.com
MAILGUN_SMTP_PASSWORD=your-mailgun-smtp-password


# AWS SES (for EMAIL_PROVIDER=ses)
AWS_REGION=us-east-1
AWS_SES_SMTP_USER=your-ses-smtp-user
AWS_SES_SMTP_PASSWORD=your-ses-smtp-password


# Resend (for EMAIL_PROVIDER=resend)
RESEND_API_KEY=re_your_api_key


# Ethereal (for development/testing)
ETHEREAL_USER=your-ethereal-user
ETHEREAL_PASSWORD=your-ethereal-password


# ============================================
# APP URLS
# ============================================
APP_URL=http://localhost:3001
DASHBOARD_URL=https://yourdomain.com/dashboard

# ============================================
# DOCKER ENVIRONMENT VARIABLES
# ============================================
# Docker-specific overrides can be set here
# For example, you might want to set different database URLs or secrets for Docker deployments
POSTGRES_DB=docker_db
POSTGRES_PORT=5432
POSTGRES_USER=docker_user
POSTGRES_PASSWORD=docker_password

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD="your_redis_password"


# ============================================
# PRODUCTION DEPLOYMENT (docker-compose.prod.yml)
# ============================================
# GitHub Container Registry — image owner's username (never changes)
GHCR_USER=rizrmdhn
# GitHub PAT with read:packages scope (get from image owner)
GHCR_TOKEN=ghp_xxxxxxxxxxxx
# Image tag to pull
IMAGE_TAG=latest
# Web port (default: 3001)
WEB_PORT=3001

# Allow LAN access from other devices on the same network.
# Run once in PowerShell as Administrator on the host machine:
#   netsh advfirewall firewall add rule name="Tepian Web" dir=in action=allow protocol=TCP localport=3001
# Then other devices can access: http://<host-ip>:3001


# ============================================
# PRODUCTION DEPLOYMENT (docker-compose.prod.yml)
# ============================================
# GitHub Container Registry — image owner's username (never changes)
GHCR_USER=rizrmdhn
# GitHub PAT with read:packages scope (get from image owner)
GHCR_TOKEN=ghp_xxxxxxxxxxxx
# Image tag to pull
IMAGE_TAG=latest
# Web port (default: 3001)
WEB_PORT=3001

# Allow LAN access from other devices on the same network.
# Run once in PowerShell as Administrator on the host machine:
#   netsh advfirewall firewall add rule name="Tepian Web" dir=in action=allow protocol=TCP localport=3001
# Then other devices can access: http://<host-ip>:3001


#  ============================================
#  OTHER CONFIGURATION
#  ============================================
# Add any additional environment variables your application needs below
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflared-tunnel-token