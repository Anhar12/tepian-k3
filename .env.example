
# ============================================
# SERVER ENVIRONMENT VARIABLES
# ============================================
SERVER_HOSTNAME=localhost
SERVER_PORT=3000
CORS_ORIGIN=http://localhost:3001


# ============================================
# REDIS CONFIGURATION
# ============================================
MEMURAI_HOST=localhost
MEMURAI_PORT=6379
MEMURAI_PASSWORD="your_redis_password"


# ============================================
# STORAGE SERVICE ENVIRONMENT VARIABLES
# ============================================
STORAGE_TYPE=filesystem # Options: filesystem, s3, minio


# Filesystem Storage Configuration (for STORAGE_TYPE=filesystem)
UPLOADS_DIR=uploads # Change this to your desired uploads directory
BASE_URL=http://localhost:3000 # Change this to your desired base URL (do not include /uploads)


# AWS S3 Configuration (for STORAGE_TYPE=s3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-key
AWS_SECRET_ACCESS_KEY=your-secret
S3_BUCKET=your-bucket-name


# MinIO Configuration (for STORAGE_TYPE=minio)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=uploads

# ============================================
# AUTHENTICATION SECRETS
# ============================================

# Main JWT secret for user authentication
# Generate with: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_min_32_chars

# Password reset token secret
# Generate with: openssl rand -base64 32
JWT_RESET_PASSWORD_SECRET=your_jwt_reset_password_secret_key_min_32_chars


# ============================================
# DOCUMENT SIGNING SECRETS
# ============================================


# Main document signing secret (REQUIRED)
# This is used to sign ALL documents with JWT
# Generate with: openssl rand -base64 32
JWT_DOCUMENT_SECRET=your_document_signing_secret_key_min_32_chars


# Optional: Type-specific document secrets for additional security isolation
# If not provided, JWT_DOCUMENT_SECRET will be used as fallback


# For legal/contractual documents (orders, invoices, assignment letters)
# Generate with: openssl rand -base64 32
JWT_LEGAL_DOCUMENT_SECRET=your_legal_document_secret_key_min_32_chars


# For testing/lab documents (reports, certificates)
# Generate with: openssl rand -base64 32
JWT_TESTING_DOCUMENT_SECRET=your_testing_document_secret_key_min_32_chars


# For company verification documents (licenses, registrations)
# Generate with: openssl rand -base64 32
JWT_COMPANY_DOCUMENT_SECRET=your_company_document_secret_key_min_32_chars


# ============================================
# DOCUMENT CONFIGURATION
# ============================================


# QR Code expiration (defaults to 10 years if not set)
# Valid formats: "7d", "30d", "1y", "10y", etc.
DOCUMENT_QR_EXPIRATION=10y


# Base URL for document verification
# Used to generate QR code verification URLs
DOCUMENT_VERIFICATION_BASE_URL=https://your-domain.com/verify/


# ============================================
# DATABASE PACKAGE ENVIRONMENT VARIABLES
# ============================================
POSTGRES_URL=postgresql://user:password@localhost:5432/dbname


# ============================================
# WEB APPLICATION ENVIRONMENT VARIABLES
# ============================================
VITE_SERVER_URL=http://localhost:3000

# Client-side storage configuration (for browser access)
# Must match server-side STORAGE_TYPE, BASE_URL, and MINIO_* settings
VITE_STORAGE_TYPE=filesystem # Options: filesystem, minio
VITE_BASE_URL=http://localhost:3000
VITE_MINIO_ENDPOINT=localhost
VITE_MINIO_PORT=9000
VITE_MINIO_USE_SSL=false
VITE_MINIO_BUCKET=uploads


# ============================================
# EMAIL CONFIGURATION
# ============================================
EMAIL_FROM="noreply@yourdomain.com"
EMAIL_PROVIDER=smtp # Options: smtp, gmail, sendgrid, mailgun, ses, resend


# SMTP Configuration (for EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password


# Gmail Configuration (for EMAIL_PROVIDER=gmail)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password


# SendGrid SMTP (for EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=your-sendgrid-api-key


# Mailgun SMTP (for EMAIL_PROVIDER=mailgun)
MAILGUN_SMTP_HOST=smtp.mailgun.org
MAILGUN_SMTP_USER=postmaster@yourdomain.com
MAILGUN_SMTP_PASSWORD=your-mailgun-smtp-password


# AWS SES (for EMAIL_PROVIDER=ses)
AWS_REGION=us-east-1
AWS_SES_SMTP_USER=your-ses-smtp-user
AWS_SES_SMTP_PASSWORD=your-ses-smtp-password


# Resend (for EMAIL_PROVIDER=resend)
RESEND_API_KEY=re_your_api_key


# Ethereal (for development/testing)
ETHEREAL_USER=your-ethereal-user
ETHEREAL_PASSWORD=your-ethereal-password


# ============================================
# APP URLS
# ============================================
APP_URL=http://localhost:3001
DASHBOARD_URL=https://yourdomain.com/dashboard