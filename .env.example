# Server Environment Variables
SERVER_HOSTNAME=localhost
SERVER_PORT=3000
CORS_ORIGIN=http://localhost:3001

# Redis Configuration
MEMURAI_HOST=localhost
MEMURAI_PORT=6379
MEMURAI_PASSWORD="your_redis_password"

# Storage Service Environment Variables
STORAGE_TYPE=filesystem # Options: filesystem, s3, minio

# Filesystem Storage Configuration (for STORAGE_TYPE=filesystem)
UPLOADS_DIR=uploads # Change this to your desired uploads directory
BASE_URL=http://localhost:3000/uploads # Change this to your desired base URL

# AWS S3 Configuration (for STORAGE_TYPE=s3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-key
AWS_SECRET_ACCESS_KEY=your-secret
S3_BUCKET=your-bucket-name

# MinIO Configuration (for STORAGE_TYPE=minio)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=uploads

# Auth Package Environment Variables
JWT_SECRET=your_jwt_secret_key
JWT_RESET_PASSWORD_SECRET=your_jwt_reset_password_secret_key

# Database Package Environment Variables
POSTGRES_URL=postgresql://user:password@localhost:5432/dbname

# Web Application Environment Variables
VITE_SERVER_URL=http://localhost:3000

# Email Configuration
EMAIL_FROM="noreply@yourdomain.com"
EMAIL_PROVIDER=smtp # Options: smtp, gmail, sendgrid, mailgun, ses, resend

# SMTP Configuration (for EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Gmail Configuration (for EMAIL_PROVIDER=gmail)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# SendGrid SMTP (for EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=your-sendgrid-api-key

# Mailgun SMTP (for EMAIL_PROVIDER=mailgun)
MAILGUN_SMTP_HOST=smtp.mailgun.org
MAILGUN_SMTP_USER=postmaster@yourdomain.com
MAILGUN_SMTP_PASSWORD=your-mailgun-smtp-password

# AWS SES (for EMAIL_PROVIDER=ses)
AWS_REGION=us-east-1
AWS_SES_SMTP_USER=your-ses-smtp-user
AWS_SES_SMTP_PASSWORD=your-ses-smtp-password

# Resend (for EMAIL_PROVIDER=resend)
RESEND_API_KEY=re_your_api_key

# Ethereal (for development/testing)
ETHEREAL_USER=your-ethereal-user
ETHEREAL_PASSWORD=your-ethereal-password

# App URLs
APP_URL=http://localhost:3001
DASHBOARD_URL=https://yourdomain.com/dashboard