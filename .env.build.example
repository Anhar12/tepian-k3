# =============================================================================
# .env.build — build-and-push.sh configuration
# Copy this to .env.build and fill in the values.
# Never commit .env.build (it contains your GHCR token).
# =============================================================================

# GitHub username
GHCR_USER=your_github_username

# GitHub PAT with write:packages scope
# Create at: https://github.com/settings/tokens → New token → write:packages
GHCR_TOKEN=ghp_xxxxxxxxxxxx

# LAN IP of the target machine (baked into the web image at build time)
# Set a static IP on the target machine first to avoid rebuilding on IP change
LAPTOP_IP=192.168.1.100

# Image tag (optional, defaults to "latest")
IMAGE_TAG=latest

# Web port (optional, defaults to 3001)
WEB_PORT=3001
