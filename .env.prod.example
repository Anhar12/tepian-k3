# =============================================================================
# .env for office laptop deployment (docker-compose.prod.yml)
# Copy this to .env and fill in the values.
# =============================================================================

# ---- GHCR (required to pull images) ----
GHCR_USER=your_github_username
IMAGE_TAG=latest

# ---- Laptop LAN IP (set a static IP on this laptop first) ----
LAPTOP_IP=192.168.1.100
WEB_PORT=3001

# ---- Database ----
POSTGRES_USER=tepian
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=tepian_k3
POSTGRES_PORT=5433

# ---- Redis ----
REDIS_PASSWORD=change_me_redis_password
REDIS_PORT=6380

# ---- JWT Secrets (min 32 chars each) ----
JWT_SECRET=change_me_at_least_32_characters_long
JWT_RESET_PASSWORD_SECRET=change_me_at_least_32_characters_long
JWT_DOCUMENT_SECRET=change_me_at_least_32_characters_long
JWT_LEGAL_DOCUMENT_SECRET=change_me_at_least_32_characters_long
JWT_TESTING_DOCUMENT_SECRET=change_me_at_least_32_characters_long
JWT_COMPANY_DOCUMENT_SECRET=change_me_at_least_32_characters_long

# ---- Document / QR ----
DOCUMENT_QR_EXPIRATION=7d
DOCUMENT_VERIFICATION_BASE_URL=http://192.168.1.100:3001/verify

# ---- Storage ----
STORAGE_PROVIDER=filesystem

# ---- Email (optional) ----
EMAIL_PROVIDER=ethereal
EMAIL_FROM=noreply@example.com
