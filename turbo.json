{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "lint": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "check-types": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:push": {
      "cache": false,
      "interactive": true
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "db:migrate": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    },
    "db:reset": {
      "cache": false
    },
    "db:snapshot": {
      "cache": false
    },
    "db:restore": {
      "cache": false
    },
    "email:dev": {
      "cache": false,
      "persistent": true
    },
    "email:verify": {
      "cache": false
    },
    "prettier": {
      "cache": false
    }
  },
  "globalEnv": ["NODE_ENV", "VITE_API_URL"],
  "globalPassThroughEnv": [
    "SERVER_HOSTNAME",
    "SERVER_PORT",
    "POSTGRES_URL",
    "CORS_ORIGIN",
    "JWT_SECRET",
    "JWT_RESET_PASSWORD_SECRET",
    "EMAIL_FROM",
    "EMAIL_PROVIDER",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_SECURE",
    "SMTP_USER",
    "SMTP_PASSWORD",
    "EMAIL_USER",
    "EMAIL_PASSWORD",
    "SENDGRID_API_KEY",
    "MAILGUN_SMTP_HOST",
    "MAILGUN_SMTP_USER",
    "MAILGUN_SMTP_PASSWORD",
    "AWS_REGION",
    "AWS_SES_SMTP_USER",
    "AWS_SES_SMTP_PASSWORD",
    "RESEND_API_KEY",
    "ETHEREAL_USER",
    "ETHEREAL_PASSWORD",
    "APP_URL",
    "DASHBOARD_URL",
    "STORAGE_PROVIDER",
    "STORAGE_PATH",
    "MEMURAI_HOST",
    "MEMURAI_PORT",
    "MEMURAI_PASSWORD",
    "JWT_DOCUMENT_SECRET",
    "JWT_LEGAL_DOCUMENT_SECRET",
    "JWT_TESTING_DOCUMENT_SECRET",
    "JWT_COMPANY_DOCUMENT_SECRET",
    "DOCUMENT_QR_EXPIRATION",
    "DOCUMENT_VERIFICATION_BASE_URL"
  ]
}
